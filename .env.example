# GEMINI_API_KEY: Required for Gemini AI API calls (RAG Mentor, ATS Rewriter, Problem Solver, Interview Probes).
# Set this in your local .env file or in Vercel Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted (e.g. https://place1ai.vercel.app or http://localhost:3000).
# Used for self-referential links, callbacks, and API endpoints.
APP_URL="MY_APP_URL"
